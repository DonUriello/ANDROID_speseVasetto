<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico di Android (API 31+): database Room e impostazioni DataStore. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
